# =============================================================================
# Root voice / streaming server (Twilio + OpenAI + tools)
# Copy to .env and fill in. Never commit real .env files.
# =============================================================================

PORT=3000
# Public URL Twilio webhooks / media use to reach this voice process (https in production).
# Example: https://calling.buddycallai.com  (must match your Twilio webhook base URL)
PUBLIC_BASE_URL=

# Optional: ring delay before AI stream connects (seconds)
RING_DELAY_SECONDS=5

# --- Twilio (voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Optional tool APIs (leave blank to disable those tools) ---
OPENWEATHER_API_KEY=
OPEN_METEO_ENABLED=true
GOOGLE_PLACES_API_KEY=
TRAVELPAYOUTS_TOKEN=
NEWS_API_KEY=
FRANKFURTER_ENABLED=true
RAPIDAPI_KEY=
WORLD_TIME_API_HOST=world-time-api3.p.rapidapi.com
API_FOOTBALL_KEY=
AVIATIONSTACK_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Landing page “Play Voice” demo (optional) ---
# POST /api/public/landing-demo-tts — keys stay on this server (not in the browser).
# With LANDING_TTS_PROVIDER=auto, Deepgram is used if DEEPGRAM_API_KEY is set, otherwise ElevenLabs.
# CORS: comma-separated Origins allowed to call this from the browser (marketing site on buddycallai.com).
# Override if you use another domain; leave unset for defaults (buddycallai.com + www + local Vite).
# LANDING_TTS_ALLOWED_ORIGINS=https://buddycallai.com,https://www.buddycallai.com
LANDING_TTS_PROVIDER=auto
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL_EN=aura-2-thalia-en
DEEPGRAM_TTS_MODEL_ES=aura-2-celeste-es
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Transcript email (SMTP) ---
# Recipients: active subscribers get the email stored in the DB for the matching phone line (via platform caller-check).
# Trial/anonymous callers fall back to EMAIL_TO (optional if you only use subscribers and always have a line email).
EMAIL_FROM=
# Optional display name in the From header (e.g. BuddyCallAI)
# SMTP_FROM_NAME=
EMAIL_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# =============================================================================
# Platform API (BuddyCallAI accounts, billing, usage deduction, call history)
# Required for: per-caller free trial (60s), subscriber balance, auto hangup, SMS alerts.
# =============================================================================
PLATFORM_API_BASE_URL=http://localhost:4000
INTEGRATION_WEBHOOK_SECRET=fYFZwACDIkpTb5hWx614NdXznPgJVrL0yl89Bi3GMUSoQmaH
USAGE_WEBHOOK_SECRET=5gFkNTPqZHj1Q7cewp9BJtXEUodrvOnM0Vzm4YRhSLCisayb
