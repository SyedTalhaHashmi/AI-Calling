# =============================================================================
# Root voice / streaming server (Twilio + OpenAI + tools)
# Copy to .env and fill in. Never commit real .env files.
# =============================================================================

PORT=3000
# Public URL Twilio webhooks / media use to reach this voice process (https in production).
# Example: https://calling.buddycallai.com  (must match your Twilio webhook base URL)
PUBLIC_BASE_URL=

# Optional: ring delay before AI stream connects (seconds)
RING_DELAY_SECONDS=5

# Local browser mic → /media-stream tester (no Twilio call). Keep false/unset in production.
# When true: open http://localhost:PORT/dev/mic-test
ENABLE_MIC_TEST=false

# Per-turn latency logs (metric=turn_latency / call_latency). Logging only — no call behavior change.
# Summarize with: node dev/latencyReport.js <logfile>
LATENCY_METRICS=true

# Live-question routing. regex (default) = existing keyword fast paths.
# tools = the model picks among the same existing services as Realtime tools (says a short
# "let me check" first). Billing, hold handling, and language rules run first in both modes.
# Rollback: set back to regex and restart.
ROUTER_MODE=regex
# Tools mode only: max ms per tool lookup before answering "took too long" (default 4000;
# 2500 timed out cold weather / flight lookups in testing).
TOOL_DEADLINE_MS=4000
# Tools mode only: Exa web search for live questions no other tool covers. Off by default.
# Free key: https://dashboard.exa.ai ($10 monthly credit). Each search: 1.5 s timeout, cached 10 min.
WEB_SEARCH_ENABLED=false
EXA_API_KEY=
# Max Exa requests per UTC day (per server process). 40/day stays inside the free credit.
WEB_SEARCH_DAILY_LIMIT=40

# --- Twilio (voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- OpenAI ---
OPENAI_API_KEY=
# --- OpenAI Realtime (calls). Every line is optional; blank = the default shown ---
# Voice model: gpt-realtime | gpt-realtime-2.1 | gpt-realtime-2.1-mini
# REALTIME_MODEL=gpt-realtime
# Reasoning models only (gpt-realtime-2.x): minimal | low | medium | high (unset = not sent)
# REALTIME_REASONING_EFFORT=
# REALTIME_VOICE=marin
# pcmu = Twilio μ-law passed straight through (default); pcm24 = convert to/from 24 kHz PCM (previous behavior)
# REALTIME_AUDIO_FORMAT=pcmu
# Caller speech-to-text model (whisper-1 is removed from the API on 2027-02-26)
# REALTIME_TRANSCRIBE_MODEL=gpt-transcribe
# Send brand and place names to the transcriber (true/false)
# REALTIME_TRANSCRIBE_HINTS=true
# near_field | far_field | off
# REALTIME_NOISE_REDUCTION=far_field
# Cost safety net: max tokens per reply (unset = model maximum)
# REALTIME_MAX_OUTPUT_TOKENS=
# Long calls: conversation tokens kept after the instructions (unset = OpenAI default)
# REALTIME_TRUNCATION_TOKENS=
# Redeploys wait this long for live calls to finish (host stop timeout must be at least this)
# SHUTDOWN_GRACE_SECONDS=25

# --- Optional tool APIs (leave blank to disable those tools) ---
OPENWEATHER_API_KEY=
OPEN_METEO_ENABLED=true
GOOGLE_PLACES_API_KEY=
TRAVELPAYOUTS_TOKEN=
NEWS_API_KEY=
FRANKFURTER_ENABLED=true
RAPIDAPI_KEY=
# Optional RapidAPI world time lookup. Off by default: local times come from Node's built-in
# time-zone data (no network call). Set true only with an active RapidAPI subscription.
WORLD_TIME_API_ENABLED=false
WORLD_TIME_API_HOST=world-time-api3.p.rapidapi.com
API_FOOTBALL_KEY=
AVIATIONSTACK_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Landing page “Play Voice” demo (optional) ---
# POST /api/public/landing-demo-tts — keys stay on this server (not in the browser).
# With LANDING_TTS_PROVIDER=auto, Deepgram is used if DEEPGRAM_API_KEY is set, otherwise ElevenLabs.
# CORS: comma-separated Origins allowed to call this from the browser (marketing site on buddycallai.com).
# Override if you use another domain; leave unset for defaults (buddycallai.com + www + local Vite).
# LANDING_TTS_ALLOWED_ORIGINS=https://buddycallai.com,https://www.buddycallai.com
LANDING_TTS_PROVIDER=auto
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL_EN=aura-2-thalia-en
DEEPGRAM_TTS_MODEL_ES=aura-2-celeste-es
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Transcript email (SMTP) ---
# Recipients: active subscribers get the email stored in the DB for the matching phone line (via platform caller-check).
# Trial/anonymous callers fall back to EMAIL_TO (optional if you only use subscribers and always have a line email).
EMAIL_FROM=
# Optional display name in the From header (e.g. BuddyCallAI)
# SMTP_FROM_NAME=
# One or more addresses, comma-separated (e.g. ops@example.com,support@example.com) — all receive the fallback transcript.
EMAIL_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# =============================================================================
# Platform API (BuddyCallAI accounts, billing, usage deduction, call history)
# Required for: per-caller free trial (60s), subscriber balance, auto hangup, SMS alerts.
# =============================================================================
PLATFORM_API_BASE_URL=http://localhost:4000
INTEGRATION_WEBHOOK_SECRET=fYFZwACDIkpTb5hWx614NdXznPgJVrL0yl89Bi3GMUSoQmaH
USAGE_WEBHOOK_SECRET=5gFkNTPqZHj1Q7cewp9BJtXEUodrvOnM0Vzm4YRhSLCisayb
